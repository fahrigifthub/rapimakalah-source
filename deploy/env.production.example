# Salin ke server\.env.production lalu isi JWT_SECRET. Jangan commit file hasil salinan.
NODE_ENV=production
PORT=4001
CLIENT_ORIGIN=https://domain-anda.example
CANONICAL_URL=https://domain-anda.example
COOKIE_SECURE=true
JWT_SECRET=GANTI_DENGAN_STRING_ACAK_PANJANG
# Opsional: Web OAuth Client ID dari Google Cloud Console
GOOGLE_CLIENT_ID=ID_OAUTH_CLIENT_WEB_APLIKASI_ANDA.apps.googleusercontent.com
DATABASE_URL=file:./dev.db
MAX_UPLOAD_MB=20